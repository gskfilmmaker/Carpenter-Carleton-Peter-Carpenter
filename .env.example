# Copy to .env.local and fill in once each provider is provisioned.
# Nothing in this repo requires these to exist yet — every integration has a working dev/test
# fallback (see docs/IMPLEMENTATION_PLAN.md "Phase 2" for what each adapter does with no key set).
# See docs/LAUNCH-INPUTS-CHECKLIST.md for the business decisions each of these depends on.

# Transactional email (src/lib/adapters/email.ts) — Resend
RESEND_API_KEY=

# Booking/calendar (src/lib/adapters/calendar.ts) — Cal.com v2 API.
# With both unset, bookings use the built-in dev slot generator (08:00-20:00 America/Toronto).
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_API_VERSION=2024-08-13

# Spam protection — Cloudflare Turnstile. With both unset, forms rely on the honeypot field +
# submit-timing check + rate limiter only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Payments (src/lib/payments.ts) — Stripe Checkout, test mode until live keys + Peter's fee
# approval. PAYMENTS_ENABLED must be "true" AND the relevant FeeItem.approved must be true for
# any charge to be possible — either gate closed means booking stays request-only, no charge.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_ENABLED=false

# Internal — exposes Peter's direct line via src/lib/server/internal-contact.ts. Stays off (no
# public surface renders it yet regardless) until a real internal/staff view is built.
SHOW_SECONDARY_PHONE=false

# CMS (if/when Sanity replaces the local content modules in src/content/*)
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_TOKEN=

# Consent-managed analytics
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_KEY=
