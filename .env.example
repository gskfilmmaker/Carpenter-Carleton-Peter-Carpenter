# Copy to .env.local and fill in once each provider is provisioned.
# Nothing in this repo requires these to exist yet — every integration has a no-op dev adapter.
# See docs/LAUNCH-INPUTS-CHECKLIST.md for the business decisions each of these depends on.

# Transactional email (src/lib/adapters/email.ts)
RESEND_API_KEY=

# Booking/calendar (src/lib/adapters/calendar.ts)
CALENDLY_API_KEY=

# CMS (if/when Sanity replaces the local content modules in src/content/*)
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_TOKEN=

# Spam protection
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Consent-managed analytics
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_KEY=
