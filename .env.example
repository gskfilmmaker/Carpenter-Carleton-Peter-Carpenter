# Copy to .env.local and fill in once each provider is provisioned.
# Nothing in this repo requires these to exist yet — every integration has a working dev/test
# fallback (see docs/IMPLEMENTATION_PLAN.md for what each adapter does with no key set).
# See docs/LAUNCH-INPUTS-CHECKLIST.md for the business decisions each of these depends on.

# Transactional email (src/lib/adapters/email.ts) — Resend. Sends from info@carpentercarleton.ca
# once that domain is verified in the Resend dashboard (Domains → Add Domain); until then, sends
# automatically retry from Resend's shared sandbox sender and log a warning — mail is never
# silently dropped. See docs/LAUNCH-INPUTS-CHECKLIST.md for the exact DNS record types to add.
RESEND_API_KEY=

# Booking/calendar (src/lib/adapters/calendar.ts) — Cal.com v2 API.
# With both unset, bookings use the built-in dev slot generator (08:00-20:00 America/Toronto).
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_API_VERSION=2024-08-13

# Spam protection — Cloudflare Turnstile. With both unset, forms rely on the honeypot field +
# submit-timing check + rate limiter only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Payments (src/lib/payments.ts) — Stripe Checkout, single GSK Productions Inc. account (GSK is
# merchant of record; this is NOT Stripe Connect). Build against TEST keys first — the same var
# names take LIVE keys later, no code change either way.
# PAYMENTS_ENABLED must be "true" AND the consultation FeeItem's `approved` flag (currently true in
# src/content/fees.ts per explicit instruction) must both hold for any charge to be possible —
# either gate closed means booking stays request-only, no charge. This repo cannot set
# PAYMENTS_ENABLED in your Vercel project itself; that's a manual dashboard step.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_ENABLED=false

# Per-charge statement descriptor (src/lib/statement-descriptor.ts) — what appears on the client's
# card statement. Defaults to "CARPENTER CARLETON" (18 characters, fits Stripe's 22-char limit)
# when unset, so this is optional; override only if the wording needs to change.
STATEMENT_DESCRIPTOR="CARPENTER CARLETON"

# Consultation tax treatment (src/lib/tax-config.ts) — public-facing display text, deliberately
# NEXT_PUBLIC_ (not a secret) so both the /book UI and the server-side Stripe/email code read the
# identical value. Examples: "HST 13%" (adds a separate tax line at that rate to the Stripe
# Checkout session), or "Taxes included" / "No tax applicable" (shown as-is, no separate line).
# Left unset, the UI/emails show a clearly-labelled TODO instead of guessing — do not set this
# without Peter's accountant confirming the correct HST treatment for the $250 CAD fee.
NEXT_PUBLIC_CONSULT_TAX=

# Internal — exposes Peter's direct line via src/lib/server/internal-contact.ts. Stays off (no
# public surface renders it yet regardless) until a real internal/staff view is built.
SHOW_SECONDARY_PHONE=false

# CMS (if/when Sanity replaces the local content modules in src/content/*)
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_TOKEN=

# Consent-managed analytics
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_KEY=
